# Railway — Expo web PWA + Convex deploy at build time
FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# ── Convex backend (Convex Cloud — not self-hosted) ──
ARG CONVEX_DEPLOY_KEY
ARG CONVEX_DEPLOYMENT
ENV CONVEX_DEPLOY_KEY=$CONVEX_DEPLOY_KEY
ENV CONVEX_DEPLOYMENT=$CONVEX_DEPLOYMENT
# Optional: the "Convex deploy" GitHub workflow already pushes the backend on merge.
RUN case "$CONVEX_DEPLOY_KEY" in \
      "") ;; \
      dev:*) npx convex dev --once ;; \
      *) npx convex deploy ;; \
    esac

# ── Static web export (served at / on Railway) ──
ARG EXPO_PUBLIC_CONVEX_URL
ENV EXPO_PUBLIC_CONVEX_URL=$EXPO_PUBLIC_CONVEX_URL
ENV EXPO_BASE_URL=/
RUN npm run build:web

ENV PORT=8080
EXPOSE 8080
CMD ["node", "server.mjs"]
