{
  "expo": {
    "name": "QuestVault",
    "slug": "questvault",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "questvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.questvault",
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#13100d",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.questvault",
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "QuestVault",
      "shortName": "QuestVault",
      "description": "Family missions, rewards and screen time — an RPG for parents and kids.",
      "themeColor": "#13100d",
      "backgroundColor": "#13100d",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/app/",
      "scope": "/app/",
      "lang": "pt-BR",
      "preferRelatedApplications": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#13100d",
          "android": {
            "image": "./assets/images/favicon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O QuestVault usa suas fotos para você mostrar as missões que entregou.",
          "cameraPermission": "O QuestVault usa a câmera para você fotografar a missão que entregou."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O QuestVault usa o microfone para você gravar como fez a missão."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/app"
    }
  }
}
